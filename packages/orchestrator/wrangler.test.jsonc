{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artfct-orchestrator",
  "main": "test/worker.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true,
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "Conversation", "class_name": "Conversation" },
      { "name": "Sandbox", "class_name": "Sandbox" },
      { "name": "SandboxLarge", "class_name": "SandboxLarge" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Conversation", "Sandbox", "SandboxLarge"] },
  ],
  "queues": {
    "producers": [{ "binding": "TRIGGER_FIRINGS", "queue": "trigger-firings" }],
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "artfct", "migrations_dir": "migrations/d1" },
  ],
  "dev": { "port": 8788, "enable_containers": false },
}
