{
  "name": "@artfct-ai/orchestrator",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./conversation": "./src/conversation.ts",
    "./sandbox": "./src/sandbox/durable-object.ts",
    "./config/*": "./src/config/*.ts"
  },
  "scripts": {
    "types": "wrangler types -c wrangler.test.jsonc --strict-vars=false --env-file /dev/null",
    "template-config": "bun scripts/template-config.ts",
    "sandbox-image": "sh sandbox/publish-image.sh",
    "db:generate": "drizzle-kit generate --config drizzle.d1.config.ts && drizzle-kit generate --config drizzle.workflow.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply artfct --local -c wrangler.test.jsonc --persist-to ../../.wrangler/state",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:medium": "vitest run",
    "lint": "oxlint",
    "spec:replay": "bun scripts/properties/pull-request-runs.ts replays",
    "spec:replay:e2e": "bun scripts/properties/e2e-property-test.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.1.0",
    "@ai-sdk/openai-compatible": "^3.0.80",
    "@ai-sdk/provider": "^4.0.34",
    "@ai-sdk/provider-utils": "^5.0.70",
    "@artfct-ai/acp": "workspace:*",
    "@artfct-ai/adapters": "workspace:*",
    "@artfct-ai/contracts": "workspace:*",
    "@cloudflare/sandbox": "^1.0.3",
    "agents": "^0.31.0",
    "ai": "^7.0.155",
    "croner": "^11.0.0",
    "drizzle-orm": "^0.45.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@artfct-ai/spec": "workspace:*",
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@informalsystems/quint": "^0.33.1",
    "drizzle-kit": "^0.31.11",
    "fast-check": "^4.10.2",
    "wrangler": "^4.154.0"
  }
}
