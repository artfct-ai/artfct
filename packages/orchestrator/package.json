{
  "name": "@artfct-ai/orchestrator",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./workflow": "./src/workflow.ts",
    "./config/*": "./src/config/*.ts"
  },
  "scripts": {
    "types": "wrangler types -c wrangler.test.jsonc --strict-vars=false --env-file /dev/null",
    "template-config": "bun scripts/template-config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.d1.config.ts && drizzle-kit generate --config drizzle.workflow.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply artfct --local -c wrangler.test.jsonc --persist-to ../../.wrangler/state",
    "typecheck": "tsc --noEmit",
    "test": "bun test && vitest run",
    "lint": "oxlint"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.5.1",
    "@ai-sdk/openai-compatible": "^3.0.59",
    "@ai-sdk/provider": "^4.0.19",
    "@artfct-ai/acp": "workspace:*",
    "@artfct-ai/adapters": "workspace:*",
    "@artfct-ai/contracts": "workspace:*",
    "@cloudflare/sandbox": "^0.12.10",
    "agents": "^0.24.0",
    "ai": "^7.0.122",
    "drizzle-orm": "^0.45.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.3",
    "drizzle-kit": "^0.31.11",
    "fast-check": "^4.10.2",
    "wrangler": "^4.144.0"
  }
}
