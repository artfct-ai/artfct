{
  "name": "@artfct-ai/core",
  "version": "0.1.0",
  "description": "The artfct engine: the orchestrator and ingress Workers, their Durable Objects, and the deployment config schema.",
  "homepage": "https://github.com/artfct-ai/artfct#readme",
  "bugs": {
    "url": "https://github.com/artfct-ai/artfct/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artfct-ai/artfct.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./orchestrator": "./dist/orchestrator.js",
    "./ingress": "./dist/ingress.js",
    "./durable-objects": "./dist/durable-objects.js",
    "./config": "./dist/config.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "types": "wrangler types -c ../../template/orchestrator/wrangler.jsonc --strict-vars=false",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:medium": "vitest run",
    "lint": "oxlint"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.8.0",
    "@ai-sdk/openai-compatible": "^3.0.73",
    "@ai-sdk/provider": "^4.0.30",
    "@ai-sdk/provider-utils": "^5.0.63",
    "@cloudflare/sandbox": "^0.12.10",
    "@linear/sdk": "^97.0.0",
    "@notionhq/client": "^5.27.1",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks-methods": "^6.0.0",
    "@openrouter/sdk": "^1.4.25",
    "@slack/web-api": "^8.2.0",
    "agents": "^0.24.0",
    "ai": "^7.0.145",
    "cloudflare": "^7.3.0",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "p-limit": "^7.3.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@artfct-ai/ingress": "workspace:*",
    "@artfct-ai/orchestrator": "workspace:*",
    "@cloudflare/vitest-plugin": "^1.4.5",
    "@types/bun": "^1.4.3",
    "rolldown": "^1.2.14",
    "rolldown-plugin-dts": "^0.28.8",
    "wrangler": "^4.151.2"
  }
}
