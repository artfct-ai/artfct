{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "no-unused-expressions": [
      "error",
      {
        "allowTaggedTemplates": true,
        "allowShortCircuit": true
      }
    ],
    "typescript/no-unsafe-type-assertion": "off",
    "id-denylist": [
      "error",
      "passTask",
      "passTaskId",
      "passIndex",
      "reviewerTask",
      "polisherTask",
      "verdict",
      "Verdict"
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^(@linear/sdk|@notionhq/client|@octokit/.+|@openrouter/sdk|@slack/.+|cloudflare(/.+)?)$",
            "message": "Only a vendor directory under packages/adapters imports a vendor SDK."
          },
          {
            "regex": "^@artfct-ai/adapters/[a-z]+/[a-z-]+/",
            "message": "Import the capability interface from its types.ts. Only a clients.ts imports a vendor directory."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/clients.ts",
        "**/*.test.ts",
        "**/*.test.medium.ts",
        "**/*.replay.ts",
        "**/*.replay.medium.ts",
        "**/*.property.ts",
        "**/*.property.medium.ts",
        "**/test/**"
      ],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      // bun-types declares the `resolves` and `rejects` matchers as void, though they return promises.
      "files": ["**/*.test.ts", "**/*.replay.ts", "**/*.property.ts"],
      "rules": { "typescript/await-thenable": "off" }
    }
  ],
  "ignorePatterns": ["dist", "node_modules", ".wrangler", "*.d.ts"]
}
