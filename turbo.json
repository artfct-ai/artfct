{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    ".oxfmtrc.jsonc",
    ".oxlintrc.json",
    "package.json",
    "tsconfig.base.json",
    "tsconfig.declarations.json",
    "template/**"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.test.medium.ts"]
    },
    "@artfct-ai/spec#transit": {
      "inputs": ["package.json"]
    },
    "types": {
      "inputs": ["wrangler.jsonc", "wrangler.test.jsonc"],
      "outputs": ["worker-configuration.d.ts"]
    },
    "template-config": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.test.medium.ts"],
      "outputs": ["test/template-config.json"]
    },
    "artfct-template#build": {
      "dependsOn": ["^build"],
      "outputs": ["orchestrator/dist/**"]
    },
    "build": {
      "dependsOn": ["transit"],
      "outputs": ["dist/**"]
    },
    "@artfct-ai/core#build": {
      "dependsOn": ["transit", "@artfct-ai/sandbox-bridge#build", "@artfct-ai/orchestrator#types"],
      "env": ["SANDBOX_IMAGE"],
      "outputs": ["dist/**"]
    },
    "@artfct-ai/orchestrator#sandbox-image": {
      "dependsOn": ["@artfct-ai/sandbox-bridge#build"],
      "inputs": ["sandbox/**", "$TURBO_ROOT$/LICENSE", "$TURBO_ROOT$/NOTICE"],
      "outputs": ["dist/sandbox-image/**"]
    },
    "@artfct-ai/core#types": {
      "dependsOn": ["@artfct-ai/core#build"],
      "outputs": ["worker-configuration.d.ts"]
    },
    "@artfct-ai/core#test": {
      "dependsOn": ["transit", "types", "build", "artfct-template#build"]
    },
    "@artfct-ai/core#test:medium": {
      "dependsOn": ["transit", "types", "build", "artfct-template#build"]
    },
    "artfct#test": {
      "dependsOn": ["transit", "@artfct-ai/core#build"]
    },
    "artfct#lint": {
      "dependsOn": ["transit", "types", "template-config", "@artfct-ai/core#build"]
    },
    "artfct#typecheck": {
      "dependsOn": ["transit", "types", "template-config", "@artfct-ai/core#build"]
    },
    "@artfct-ai/core#lint": {
      "dependsOn": ["transit", "types", "artfct-template#build"]
    },
    "@artfct-ai/core#typecheck": {
      "dependsOn": ["transit", "types", "artfct-template#build"]
    },
    "typecheck": {
      "dependsOn": ["transit", "types", "template-config"]
    },
    "test": {
      "dependsOn": ["transit", "types", "template-config"]
    },
    "@artfct-ai/orchestrator#test": {
      "dependsOn": ["transit", "types", "template-config"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/spec/*/**/*"]
    },
    "@artfct-ai/orchestrator#spec:replay": {
      "dependsOn": ["transit", "types", "template-config"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.medium.ts",
        "$TURBO_ROOT$/spec/*/**/*"
      ]
    },
    "@artfct-ai/orchestrator#spec:replay:e2e": {
      "dependsOn": ["transit", "types", "template-config"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.medium.ts",
        "$TURBO_ROOT$/spec/*/**/*"
      ],
      "passThroughEnv": ["PROPERTY_SEED", "GITHUB_STEP_SUMMARY"]
    },
    "test:medium": {
      "dependsOn": ["transit", "types", "template-config"]
    },
    "lint": {
      "dependsOn": ["transit", "types", "template-config"]
    },
    "db:migrate:local": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "//#typecheck:root": {
      "dependsOn": ["@artfct-ai/orchestrator#template-config"]
    },
    "//#lint:root": {
      "dependsOn": ["@artfct-ai/orchestrator#template-config"]
    },
    "//#knip": {
      "inputs": ["$TURBO_DEFAULT$", "packages/**", "template/**"]
    },
    "//#test:root": {
      "inputs": [
        "scripts/**",
        "spec/glossary.md",
        "packages/*/src/**",
        "packages/*/migrations/**",
        "template/**"
      ]
    },
    "//#fmt:check": {}
  }
}
