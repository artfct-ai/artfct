{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["./packages/orchestrator/worker-configuration.d.ts", "node"],
    "resolveJsonModule": true
  },
  "include": [
    "packages/core/src",
    "packages/orchestrator/src",
    "packages/ingress/src",
    "packages/adapters/src",
    "packages/contracts/src",
    "packages/acp/src"
  ],
  "exclude": [
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/*.test.medium.ts",
    "packages/*/src/**/*.replay.ts",
    "packages/*/src/**/*.replay.medium.ts",
    "packages/*/src/**/*.property.ts",
    "packages/*/src/**/*.property.medium.ts"
  ]
}
